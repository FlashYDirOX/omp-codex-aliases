{
  "name": "omp-sub-alias",
  "version": "0.1.1",
  "description": "Subscription provider aliases for Oh My Pi / OMP.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "oh-my-pi",
    "omp",
    "extension",
    "provider",
    "oauth",
    "openai",
    "codex",
    "chatgpt"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "verify": "npm run typecheck && npm test && npm run build && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@oh-my-pi/pi-catalog": "18.2.7"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=18 <19",
    "@oh-my-pi/pi-coding-agent": ">=18 <19"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.2.7",
    "@oh-my-pi/pi-coding-agent": "18.2.7",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.10.0",
    "typescript": "^6.0.2"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
